DATABASE_URL="file:./dev.db"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-long-random-string"
JWT_EXPIRES_IN="7d"

# Зависшее чтение обрывается ответом 503 + Retry-After (мс)
REQUEST_TIMEOUT_MS=15000
# Попытки подключения к базе при старте: сервер поднимется в любом случае и будет
# отвечать 503, пока база не откроется
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_DELAY_MS=500
